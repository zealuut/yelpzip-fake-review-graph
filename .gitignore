# Ignore everything by default.
/*

# Keep the repository surface.
!/.gitignore
!/README.md
!/graph/
!/graph/**
!/reports/
!/reports/**

# Never track heavy or local-only artifacts.
graph/logs/
graph/outputs/**
!graph/outputs/
!graph/outputs/README.md
!graph/outputs/**/
!graph/outputs/**/run_config.json
!graph/outputs/**/run_summary.json
!graph/outputs/**/config.json
!graph/outputs/**/route_summary.csv
!graph/outputs/**/route_summary.md
!graph/outputs/**/analysis_*.md
!graph/outputs/**/comparison_vs_*.md
!graph/outputs/**/prepared_data/dataset_metadata.json
graph/outputs/**/prepared_data/*
graph/outputs/**/edges/*.csv
!graph/outputs/**/metrics/model_results*.csv
!graph/outputs/**/metrics/edge_stats.csv
!graph/outputs/**/metrics/**/abnormal_pair_score_stats.csv
!graph/outputs/**/metrics/**/edge_weight_before_after_by_relation.csv
!graph/outputs/**/metrics/**/cb_weight_before_after_quantiles.csv
!graph/outputs/**/edges/edge_build_config.json
!graph/outputs/three_routes_summary_*.csv
!graph/outputs/three_routes_summary_*.md
graph/__pycache__/
graph/run_all.secrets.env
local_models/
pretrain_model/
graph data/
.idea/
.venv/
*.pyc
*.pyo
*.log
*.pid
*.pt
*.bin
*.safetensors
*.npy
*.npz
*.csv.gz
